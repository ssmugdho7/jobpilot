# Gemini API keys (Google AI Studio) — used for CV parsing + ATS CV generation
# Option A: comma-separated list (recommended for multiple keys)
# GEMINI_API_KEYS=key1,key2,key3
# Option B: numbered keys (GEMINI_API_KEY_1, GEMINI_API_KEY_2, ...)
# Option C: single key (fallback)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview

# Facebook Graph API access token — required to fetch job posts from the
# groups/pages listed under facebook_groups / facebook_pages in
# config/search.yaml. Facebook blocks anonymous scraping, so no token = no
# Facebook jobs (use the manual-add box for Facebook posts instead).
# Get a token: developers.facebook.com -> Create App -> Tools -> Graph API
# Explorer -> generate a user/page token with "pages_read_engagement"
# and/or "groups_read_member" permissions.
FACEBOOK_ACCESS_TOKEN=
